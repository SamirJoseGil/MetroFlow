# MetroFlow 2.0 - Backend
# Puerto HTTP del API
PORT=18080

# Dirección de escucha (0.0.0.0 expone a red local / servidor)
HOST=0.0.0.0

# Ruta al grafo JSON que usa el backend
GRAPH_PATH=../data/graph.json

# Ruta a frontend/dist para servir estáticos (útil en despliegue integrado)
STATIC_DIR=../frontend/dist

# Logs
LOG_LEVEL=info